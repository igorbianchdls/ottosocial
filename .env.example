# Clerk (dashboard.clerk.com → API Keys): login, workspaces (organizations), invites and account e-mails.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server only — never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
# Clerk → Webhooks → your endpoint → Signing secret (for /api/clerk/webhook).
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (Settings → API Keys): data and files. Clerk must be added as a third-party auth provider.
NEXT_PUBLIC_SUPABASE_URL=https://zetepnoysdjqfmgevvrt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: lets the webhook delete a workspace's rows and files.
SUPABASE_SECRET_KEY=

# Composio (Conectores): login, tokens and actions of each connected service. Server only.
# Settings → API Keys.
COMPOSIO_API_KEY=
# Our connector id → its auth config in Composio, e.g. {"instagram":"ac_...","metaads":"ac_..."}.
# A connector without an entry shows as "Em breve".
COMPOSIO_AUTH_CONFIGS={}
# Secret of the webhook subscription pointing at https://<app>/api/conectores/webhook
# (event composio.connected_account.expired).
COMPOSIO_WEBHOOK_SECRET=
